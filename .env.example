# Example Environment Variables for ViZioN

# Hugging Face API token (optional, if you need to access private models or for other HF features)
# HF_TOKEN="your_huggingface_token_here"

# VLLM Server Configuration
# The URL of your running vLLM OpenAI-compatible API server.
# Default: http://localhost:8051/v1/chat/completions
VLLM_URL="http://localhost:8051/v1/chat/completions"

# The model ID that the vLLM server is hosting.
# This should match the --model argument used when starting the vLLM server.
# Default: Qwen/Qwen3-VL-8B-Instruct
VLLM_MODEL_ID="Qwen/Qwen3-VL-8B-Instruct"

# Device to run models on. 'cuda' for GPU (recommended), 'cpu' for CPU.
# DEVICE="cuda" 
